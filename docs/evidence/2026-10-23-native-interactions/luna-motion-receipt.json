    "sourceDsl": "root = Document(\"quadratic-a\", $ui, [Paper(\"panel\", [Text(\"hint\", \"拖动图上的圆点改变 a；圆点的横坐标就是 a。\", \"body\", \"muted\"), Button(\"shake-button\", \"轻晃一下\", @LocalChange({shake: @Add($ui.shake, 1)}), \"normal\"), Text(\"shake-note\", \"曲线和拖点一起右移 20 px 再回原处；坐标轴不动。拖点始终可以直接拖动。\", \"small\", \"muted\"), Flow(\"equations\", [Formula(\"formula-curve\", \"y=ax^2\", true), Formula(\"formula-at-2\", \"y(2)=a\\\\cdot 2^2=4a\", true)], \"row\", 16, 2, \"center\"), Flow(\"readouts\", [Text(\"a-label\", \"当前 a\", \"small\", \"muted\"), Text(\"a-value\", @FormatNumber($ui.a, 2), \"title\", \"accent\"), Text(\"x2-label\", \"x=2 时 y\", \"small\", \"muted\"), Text(\"y2-value\", @FormatNumber(@Multiply($ui.a, 4), 2), \"title\", \"accent\")], \"row\", 12, 4, \"center\"), Graphic(\"graph\", {xMin: -3, xMax: 3, yMin: 0, yMax: 27}, \"抛物线随 a 改变\", [Motion(\"shake-motion\", [{x: 0}, {x: 20}, {x: 0}], [Group(\"moving-curve-and-handle\", [Curve(\"curve\", \"a*x^2\", -3, 3, {a: $ui.a}, \"ink\", 180, 2.5, false, \"x\"), DragHandle(\"a-handle\", \"拖动 a\", \"a\")])], $ui.shake, 1000, 1, \"ease\", \"finish\")], 320, \"up\", true, \"x\", \"y\", \"independent\")], \"paper\", 18)], \"y=a x² · 拖动看看\")"
  },
